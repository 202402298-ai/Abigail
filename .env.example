# Copia este archivo a ".env" (mismo directorio que manage.py) y llena los
# valores reales. El archivo ".env" NUNCA se debe subir a git (ya está en
# .gitignore) porque contiene secretos.

# Genera una clave nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-generada-y-secreta

# En producción SIEMPRE debe ser False.
DJANGO_DEBUG=False

# Dominio(s) o IP desde donde se va a acceder al sitio, separados por coma.
DJANGO_ALLOWED_HOSTS=seguimiento-itsm.3c.group,192.168.1.50

# Cadena de conexión a Postgres: postgres://usuario:password@host:5432/nombre_bd
DATABASE_URL=postgres://seguimiento_itsm:CAMBIA_ESTA_PASSWORD@localhost:5432/seguimiento_itsm

# Ponlo en False solo si todavía no tienes HTTPS configurado (ej. mientras
# pruebas por primera vez); actívalo en cuanto tengas el certificado.
DJANGO_SECURE_SSL_REDIRECT=True
